{
  "manifest_version": 3,
  "name": "Auto Refresh Cache",
  "version": "1.0.0",
  "description": "Remember exact-page refresh intervals with independent tab timers and pauses.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Refresh Cache",
    "default_icon": {
      "16": "icons/refresh-16.png",
      "32": "icons/refresh-32.png",
      "48": "icons/refresh-48.png",
      "128": "icons/refresh-128.png"
    }
  },
  "icons": {
    "16": "icons/refresh-16.png",
    "32": "icons/refresh-32.png",
    "48": "icons/refresh-48.png",
    "128": "icons/refresh-128.png"
  }
}
